# ==============================================================
# ĐẶNG NĂM AI (dangnam.online) - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế.
# Tuyệt đối KHÔNG commit tệp .env chứa API Key thực vào Git.

# --- CẤU HÌNH MÁY CHỦ (SERVER CONFIG) ---
NODE_ENV=production
PORT=3000
JSON_LIMIT=22mb
# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGIN=https://dangnam.online,https://www.dangnam.online,http://localhost:3000

# --- GIỚI HẠN TẦN SUẤT (RATE LIMITING) ---
# Giới hạn yêu cầu AI cho mỗi IP (mặc định: 25 requests / 15 phút)
RATE_LIMIT_AI_MAX=25
RATE_LIMIT_AI_WINDOW_MS=900000
# Giới hạn đăng nhập/đăng ký cho mỗi IP
RATE_LIMIT_AUTH_MAX=30
# Giới hạn API chung cho mỗi IP
RATE_LIMIT_GENERAL_MAX=300

# --- CHẾ ĐỘ MÔ HÌNH MIỄN PHÍ (FREE MODE) ---
# Đặt true nếu chỉ muốn dùng các model miễn phí hoàn toàn (OpenRouter Free Router)
FREE_MODELS_ONLY=false
DEFAULT_AI_PROVIDER=auto

# --- GOOGLE GEMINI AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3-pro-image,gemini-2.5-flash-image

# --- GROQ (TỐC ĐỘ CAO / MIỄN PHÍ) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OPENROUTER (ROUTER ĐA MÔ HÌNH) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_SITE_URL=https://dangnam.online

# --- OPENAI (CHATGPT) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- ANTHROPIC CLAUDE ---
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest

# --- CÁC NHÀ CUNG CẤP KHÁC (TÙY CHỌN) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROK_API_KEY=
GROK_MODEL=grok-2-latest
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MANUS_API_KEY=
MANUS_MODEL=manus-latest

# --- FIREBASE CLIENT AUTHENTICATION ---
# Lấy từ Firebase Console -> Project Settings -> General -> Web App Config
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=dangnam-tuvi.firebaseapp.com
FIREBASE_PROJECT_ID=dangnam-tuvi
FIREBASE_STORAGE_BUCKET=dangnam-tuvi.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=183878060405
FIREBASE_APP_ID=1:183878060405:web:c40387b975b1bf077d2b3c
FIREBASE_MEASUREMENT_ID=G-RJ2LBTXYSJ
