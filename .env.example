# Copy to .env on the server, then enter keys locally; never commit .env or paste secrets into chat.
NODE_ENV=production
PORT=3000

# Strict no-cost mode: only OpenRouter's documented $0 Free Models Router is enabled.
FREE_MODELS_ONLY=true
DEFAULT_AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini has an official free tier, but this app cannot tell whether the Google project
# is on Free or Paid billing. Its key is retained but not called in strict free-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# These API providers can incur charges and are blocked while FREE_MODELS_ONLY=true.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: allow only your deployed web origin(s), comma-separated.
# CORS_ORIGIN=https://your-domain.example
